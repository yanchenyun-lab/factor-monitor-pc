# ==========================================
# 1. 常见编辑器与 IDE 配置文件
# ==========================================
# JetBrains 全家桶 (PyCharm, IntelliJ IDEA, WebStorm 等)
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code 配置与工作区
.vscode/
*.code-workspace
.history/

# Eclipse / STS
.project
.classpath
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# 各种临时/备份文件
*.swp
*.swo
*~
*.bak


# ==========================================
# 2. 操作系统自动生成的垃圾文件
# ==========================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# ==========================================
# 3. 项目运行环境与编译产物（顺便检查防漏）
# ==========================================
# Python 编译与虚拟环境
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/

# 前端 Node.js / Vue 产物与依赖
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# 后端 Java / Maven 编译打包产物
target/
*.class
*.jar
*.war
*.ear

# 日志文件
logs/
*.log